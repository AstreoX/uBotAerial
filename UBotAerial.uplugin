{
    "FileVersion": 3,
    "Version": 1,
    "VersionName": "0.1.0",
    "FriendlyName": "uBot Aerial",
    "Description": "uBot multirotor drones: simplified flight for navigation research, rigid-body dynamics with velocity, attitude, body-rate and motor control for flight-control research, wind, keyboard or gamepad flight, and example drone Blueprints with a demo map. No ROS dependency.",
    "Category": "uBot",
    "CreatedBy": "AstreoX",
    "CreatedByURL": "https://github.com/AstreoX",
    "DocsURL": "https://github.com/AstreoX/uBotAerial",
    "CanContainContent": true,
    "IsBetaVersion": true,
    "Plugins": [
        {
            "Name": "UBotCore",
            "Enabled": true
        },
        {
            "Name": "EnhancedInput",
            "Enabled": true
        }
    ],
    "Modules": [
        {
            "Name": "UBotAerial",
            "Type": "Runtime",
            "LoadingPhase": "Default"
        }
    ],
    "UBot": {
        "Layer": "Capability",
        "Repository": "https://github.com/AstreoX/uBotAerial.git",
        "Requires": [
            {
                "Name": "UBotCore",
                "Version": "^0.1.2"
            }
        ],
        "EnginePlugins": [
            "EnhancedInput"
        ],
        "Provides": [
            "Actuation.Velocity",
            "Actuation.Attitude",
            "Actuation.Motor",
            "Body.Multirotor",
            "Aerial.Wind"
        ],
        "Tags": [
            "aerial"
        ]
    }
}
